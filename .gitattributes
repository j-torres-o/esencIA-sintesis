# Auto-detect text files and perform LF normalization on checkout/commit
* text=auto

# Python, Web & Documentation files - use LF
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows Scripts & Installer Configs - use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf
*.spec text eol=crlf

# Binary files - preserve as-is
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
